# Database connection string
DATABASE_URL="postgresql://username:password@localhost:5432/prera_db"

# Server Port (macOS uses 5000 for AirPlay, so 5001 is recommended)
PORT=5001

# Node Environment
NODE_ENV=development

# JWT Secret Key
JWT_SECRET="replace_with_a_secure_secret_key_prera_jwt_2026"
JWT_EXPIRES_IN="7d"

# Default Admin Credentials for Seeding (Run: npm run seed)
ADMIN_NAME="PRERA Admin"
ADMIN_EMAIL="admin@prera.com"
ADMIN_PASSWORD="admin_prera_secure_2026"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"
